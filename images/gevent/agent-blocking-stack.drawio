          <mxGeometry height="60" width="580" x="80" y="170" as="geometry" />
        </mxCell>
        <mxCell id="s2-s3" edge="1" parent="1" source="s2" style="endArrow=classic;html=1;strokeColor=#1F2937;strokeWidth=1.5;exitX=0.07;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" target="s3">
          <mxGeometry relative="1" as="geometry" />
