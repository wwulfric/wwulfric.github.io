          <mxGeometry height="60" width="620" x="40" y="80" as="geometry" />
        </mxCell>
        <mxCell id="s1-s2" edge="1" parent="1" source="s1" style="endArrow=classic;html=1;strokeColor=#1F2937;strokeWidth=1.5;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.05;entryY=0;entryDx=0;entryDy=0;" target="s2">
