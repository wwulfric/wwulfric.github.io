        <mxCell id="R-high" value="Python 标准库（高层）&#10;socket.py · threading.py（已被 patch，但 agent 不走这里）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=1.5;fontFamily=Noto Sans CJK SC,Helvetica;fontSize=12;fontColor=#6B7280;dashed=1;" vertex="1" parent="1">
