        <mxCell id="patch-line-lbl" value="↓ monkey patch 的作用范围在这一层（覆盖 socket / threading / time / select 等）" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontFamily=Noto Sans CJK SC,Helvetica;fontColor=#B91C1C;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="50" y="145" width="600" height="20" as="geometry" />
        </mxCell>
        <mxCell id="summary" value="关键观察：monkey patch 只能替换 Python 层的高层 API（socket.py / threading.py），无法触及由 C 实现的底层原语（_socket / _thread）。把 agent 控制面退到底层原语，就避开了 patch 的作用范围。" style="rounded=1;arcSize=5;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#1F2937;strokeWidth=1.5;fontFamily=Noto Sans CJK SC,Helvetica;fontSize=11;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="1020" height="80" as="geometry" />
        </mxCell>
      </root>
