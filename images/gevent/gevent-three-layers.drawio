          <mxGeometry x="80" y="200" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="greenlet C&#10;background_job()" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1F6FEB;strokeWidth=1.5;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1">
