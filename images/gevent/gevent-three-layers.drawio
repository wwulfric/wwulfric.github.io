        <mxCell id="g-note" value="一个 OS 线程里同时存在大量业务 greenlet&#10;每个 greenlet 有自己的调用栈" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;fontFamily=Noto Sans CJK SC,Helvetica;fontColor=#6B7280;" vertex="1" parent="1">
