        <mxCell id="hub-to-ev" style="endArrow=classic;html=1;strokeColor=#1F2937;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="hub" target="ev">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hub-to-ev-lbl" value="跑 event loop&#10;等内核事件" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;fontFamily=Noto Sans CJK SC,Helvetica;fontColor=#1F2937;" vertex="1" parent="1">
