        </mxCell>
        <mxCell id="footnote" value="同一时刻只有一个 greenlet 在跑。greenlet 之间靠协作点切换，不受操作系统抢占。" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontFamily=Noto Sans CJK SC,Helvetica;fontColor=#6B7280;" vertex="1" parent="1">
