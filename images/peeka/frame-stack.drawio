        <mxCell id="frame-main" value="frame: main&#10;f_code.co_name = 'main'&#10;f_lineno = 15&#10;f_locals = {}&#10;f_back -> None" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1F6FEB;fontFamily=Courier New;fontSize=10;strokeWidth=1.5;align=left;spacing=8;verticalAlign=top;" vertex="1" parent="1">
