        <mxCell id="title" value="gevent 下 sys.settrace 看到的事件流：调度边对 CPython 不可见" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontFamily=Noto Sans CJK SC,Helvetica;fontColor=#1F2937;" vertex="1" parent="1">
