          </mxGeometry>
        </mxCell>
        <mxCell id="sw3-lbl" value="switch&#10;(C/汇编层)" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;fontFamily=Noto Sans CJK SC,Helvetica;fontColor=#B45309;" vertex="1" parent="1">
          <mxGeometry x="820" y="290" width="90" height="30" as="geometry" />
        </mxCell>

        <mxCell id="time-axis" style="endArrow=classic;html=1;rounded=0;strokeColor=#6B7280;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="200" y="420" as="sourcePoint" />
            <mxPoint x="1100" y="420" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="time-lbl" value="时间" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontFamily=Noto Sans CJK SC,Helvetica;fontColor=#6B7280;" vertex="1" parent="1">
          <mxGeometry x="1100" y="430" width="60" height="20" as="geometry" />
        </mxCell>

        <mxCell id="note" value="settrace 看到的事件序列是 call A -> call B -> return A -> return B。逻辑栈本来是「A 进入 -> A 挂起 -> B 进入 -> B 挂起 -> A 恢复返回 -> B 恢复返回」。橙色 switch 边发生在 greenlet 自己的 C 汇编栈拷贝里，CPython 没有为这次切换定义任何事件。" style="rounded=1;arcSize=5;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#1F2937;fontFamily=Noto Sans CJK SC,Helvetica;fontSize=11;fontStyle=2;strokeWidth=1.5;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="465" width="1120" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
