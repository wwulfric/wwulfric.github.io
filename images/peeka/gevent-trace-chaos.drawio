        <mxCell id="b-run1" value="task B 执行至 sleep(0)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FEB;fontFamily=Noto Sans CJK SC,Helvetica;fontSize=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="440" y="330" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b-susp" value="挂起" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontFamily=Noto Sans CJK SC,Helvetica;fontSize=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="640" y="330" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b-run2" value="task B 恢复并返回" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F6FEB;fontFamily=Noto Sans CJK SC,Helvetica;fontSize=10;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="900" y="330" width="170" height="40" as="geometry" />
