        <mxCell id="ev4" value="return task(B)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2937;fontFamily=Courier New;fontSize=10;strokeWidth=1.5;" vertex="1" parent="1">
