        <mxCell id="sw2-line" style="endArrow=none;html=1;rounded=0;strokeColor=#B45309;strokeWidth=1.5;dashed=1;dashPattern=2 4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="660" y="170" as="sourcePoint" />
            <mxPoint x="660" y="390" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sw2-lbl" value="switch&#10;(C/汇编层)" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;fontFamily=Noto Sans CJK SC,Helvetica;fontColor=#B45309;" vertex="1" parent="1">
          <mxGeometry x="615" y="180" width="90" height="30" as="geometry" />
        </mxCell>

        <mxCell id="sw3-line" style="endArrow=none;html=1;rounded=0;strokeColor=#B45309;strokeWidth=1.5;dashed=1;dashPattern=2 4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
