<mxfile host="app.diagrams.net" agent="manual" version="24.0.0">
  <diagram id="suspend-comparison" name="suspend-point-comparison">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="gevent 与 asyncio 的暂停点：一个在汇编层，一个在字节码层" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontFamily=Noto Sans CJK SC,Helvetica;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1120" height="30" as="geometry" />
        </mxCell>

        <mxCell id="gv-title" value="gevent: 暂停点在 C/汇编层 (CPython 不感知)" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontFamily=Noto Sans CJK SC,Helvetica;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1120" height="24" as="geometry" />
        </mxCell>
        <mxCell id="gv-py" value="Python 层&#10;gevent.sleep(0)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1F6FEB;fontFamily=Noto Sans CJK SC,Helvetica;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="gv-bc" value="字节码层&#10;CALL gevent.sleep" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#1F2937;fontFamily=Courier New;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="320" y="110" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="gv-c" value="C 扩展层&#10;greenlet.switch()" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;fontFamily=Courier New;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="580" y="110" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="gv-asm" value="汇编层&#10;slp_switch: memcpy 栈" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;fontFamily=Courier New;fontSize=11;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="840" y="110" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="gv-e1" style="endArrow=classic;html=1;rounded=0;strokeColor=#1F2937;strokeWidth=1.5;" edge="1" parent="1" source="gv-py" target="gv-bc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gv-e2" style="endArrow=classic;html=1;rounded=0;strokeColor=#1F2937;strokeWidth=1.5;" edge="1" parent="1" source="gv-bc" target="gv-c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gv-e3" style="endArrow=classic;html=1;rounded=0;strokeColor=#1F2937;strokeWidth=1.5;" edge="1" parent="1" source="gv-c" target="gv-asm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gv-mark" value="↑ 暂停发生在这里" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontFamily=Noto Sans CJK SC,Helvetica;fontColor=#B91C1C;" vertex="1" parent="1">
          <mxGeometry x="840" y="165" width="280" height="20" as="geometry" />
        </mxCell>
        <mxCell id="gv-mon" value="sys.monitoring 事件：(无相关事件)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B91C1C;fontFamily=Courier New;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="200" width="540" height="36" as="geometry" />
        </mxCell>
        <mxCell id="gv-fix" value="补救：greenlet.settrace 接 switch / throw" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;fontFamily=Courier New;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="620" y="200" width="500" height="36" as="geometry" />
        </mxCell>
        <mxCell id="sep" style="endArrow=none;html=1;rounded=0;strokeColor=#6B7280;strokeWidth=1.5;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="40" y="275" as="sourcePoint" />
            <mxPoint x="1160" y="275" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="as-title" value="asyncio: 暂停点在字节码层 (CPython 原生暴露)" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontFamily=Noto Sans CJK SC,Helvetica;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="295" width="1120" height="24" as="geometry" />
        </mxCell>
        <mxCell id="as-py" value="Python 层&#10;await asyncio.sleep(0)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1F6FEB;fontFamily=Noto Sans CJK SC,Helvetica;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="335" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="as-bc" value="字节码层&#10;SEND / YIELD_VALUE" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#BFDBFE;strokeColor=#1F6FEB;fontFamily=Courier New;fontSize=11;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="320" y="335" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="as-frame" value="frame 仍存活&#10;gen_frame_state = SUSPENDED" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#1F2937;fontFamily=Courier New;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="580" y="335" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="as-loop" value="event loop 选下个 Task&#10;再 SEND 恢复" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1F6FEB;fontFamily=Noto Sans CJK SC,Helvetica;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="900" y="335" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="as-e1" style="endArrow=classic;html=1;rounded=0;strokeColor=#1F2937;strokeWidth=1.5;" edge="1" parent="1" source="as-py" target="as-bc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="as-e2" style="endArrow=classic;html=1;rounded=0;strokeColor=#1F2937;strokeWidth=1.5;" edge="1" parent="1" source="as-bc" target="as-frame">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="as-e3" style="endArrow=classic;html=1;rounded=0;strokeColor=#1F2937;strokeWidth=1.5;" edge="1" parent="1" source="as-frame" target="as-loop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="as-mark" value="↑ 暂停发生在这里" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontFamily=Noto Sans CJK SC,Helvetica;fontColor=#1F6FEB;" vertex="1" parent="1">
          <mxGeometry x="320" y="390" width="220" height="20" as="geometry" />
        </mxCell>
        <mxCell id="as-mon" value="sys.monitoring 事件：PY_YIELD (暂停) / PY_RESUME (恢复)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1F6FEB;fontFamily=Courier New;fontSize=11;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="425" width="540" height="36" as="geometry" />
        </mxCell>
        <mxCell id="as-fix" value="只需 asyncio.current_task() 给事件打 Task 身份" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#1F2937;fontFamily=Courier New;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="620" y="425" width="500" height="36" as="geometry" />
        </mxCell>

        <mxCell id="note" value="同样是协作式并发，gevent 在 frame 之外切换 (汇编层栈拷贝) 所以 CPython 看不见；asyncio 把暂停下沉成字节码指令，sys.monitoring 原生就有事件。这决定了两边可观测性的根本差异。" style="rounded=1;arcSize=5;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#1F2937;fontFamily=Noto Sans CJK SC,Helvetica;fontSize=11;fontStyle=2;strokeWidth=1.5;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="495" width="1120" height="56" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
